# Browser-safe values (Vite exposes VITE_* variables to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=
NIRDHOOM_AI_MODEL=
REQUIRE_AUTH_FOR_AI=true

# Dispatch and remote sensing
DISPATCH_SERVICE_URL=
DISPATCH_SERVICE_TOKEN=
FIRMS_MAP_KEY=
REQUIRE_AUTH_FOR_FIRMS=true

# Payments intentionally disabled in this release. Do not add provider credentials.\n\n# Messaging and IVR
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
IVR_WEBHOOK_URL=
IVR_PROVIDER_TOKEN=

# Sentinel Hub (only if the ingestion service is implemented)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
\n# Demo mode is opt-in. Keep false/empty for production/live-data surfaces.\nVITE_NIRDHOOM_DEMO_MODE=false\n