# Browser-safe values (Vite exposes VITE_* variables to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
OPENAI_API_KEY=
NIRDHOOM_AI_MODEL=
REQUIRE_AUTH_FOR_AI=true

# Dispatch and remote sensing
DISPATCH_SERVICE_URL=
DISPATCH_SERVICE_TOKEN=
FIRMS_MAP_KEY=
REQUIRE_AUTH_FOR_FIRMS=true

# Payments: configure only the selected provider's credentials.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_API_URL=
PAYMENT_WEBHOOK_SECRET=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox

# Messaging and IVR
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
IVR_WEBHOOK_URL=
IVR_PROVIDER_TOKEN=

# Sentinel Hub (only if the ingestion service is implemented)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
